# Template only. Copy to .env in this folder and paste your key there. .env is git-ignored.
#
# src/config.py looks for the key in this order:
#   1. the real environment variable named below
#   2. .env in this folder          <- the usual place; edit it whenever the key changes
#   3. .api_key in this folder      <- the older single-line file, also ignored
#
#   Windows PowerShell   $env:GROQ_API_KEY = "gsk_..."
#   Git Bash             export GROQ_API_KEY="gsk_..."
#   either               echo 'GROQ_API_KEY=gsk_...' > .env
#
# A key that has been pasted into a chat, an email or any repo - even a private one - should be
# rotated at console.groq.com/credentials before this project is shared with anyone.
GROQ_API_KEY=
