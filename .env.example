# Template only. Copy the value into your environment; never commit a real key.
#
# This project does not read a .env file: src/config.py takes the key from the environment
# variable named below, or from an untracked .api_key file in this folder (already gitignored).
#
#   Windows PowerShell   $env:GROQ_API_KEY = "gsk_..."
#   Git Bash             export GROQ_API_KEY="gsk_..."
#   either               echo "gsk_..." > .api_key
#
# A key that has been pasted into a chat, an email or any repo - even a private one - should be
# rotated at console.groq.com/credentials before this project is shared with anyone.
GROQ_API_KEY=
