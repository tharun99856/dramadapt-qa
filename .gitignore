# Never commit a key.
.api_key
*.key
.env
# If a local secrets.toml is ever used to test the hosted path, it stays local too.
.streamlit/secrets.toml

# The Kuku input pack must not appear in this repository in any form.
# Excluded by name pattern so a stray copy cannot be added by accident.
*[Pp]ack*/
*Kuku*[Pp]ack/
*input_pack/
*input-pack/
*kuku_pack/
*confidential*/
*_source_material/

# Local environment and tooling noise
__pycache__/
# Intermediate HTML the PDF build writes before Chrome reads it.
build/
# Working copies the builder makes while re-running experiments; not part of the submission.
scratch/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
desktop.ini
