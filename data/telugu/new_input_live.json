      "telugu": "Idi ikkada vadakandi.",
      "script_detected": "LATIN",
      "is_telugu": false,
      "slot_seconds": 1.6,
      "english": "Don't use that here."
    },
    {
      "line_id": "E01-L032",
      "telugu": "Kameralu kosam stairwell lo evaru levaru.",
      "script_detected": "LATIN",
      "is_telugu": false,
      "slot_seconds": 1.8,
      "english": "Nobody is in a stairwell for the cameras."
    },
    {
      "line_id": "E01-L033",
      "telugu": "Meeru raatri lo nannu nijam cheppadaniki anumatam ichina rendu vyakti lo rendu.",
      "script_detected": "LATIN",
      "is_telugu": false,
      "slot_seconds": 2.2,
      "english": "You are the second person tonight who has told me where I am allowed to be honest."
