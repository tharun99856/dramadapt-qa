{
  "_note": "Raw Telugu output for Phase 0 Step A, produced in-session by the agent model under the fixed prompt stored in config.yaml (first_pass.instruction + the JSON contract in scripts/run_first_pass.py). Imported with --from-file so no token or cost figures are claimed. This file is the response as returned; it has not been hand-edited.",
  "lines": [
    {"line_id": "E01-L001", "telugu": "దీపం వెలుగుతూనే ఉంటుంది."},
    {"line_id": "E01-L003", "telugu": "గంట క్రితమే నేను పెట్టేశాను."},
    {"line_id": "E01-L004", "telugu": "నువ్వు నిద్రపోతున్నప్పుడు కేన్ మళ్ళీ వచ్చారు."},
    {"line_id": "E01-L005", "telugu": "నేను నిద్రపోతే ఆమె ఎల్లప్పుడూ వస్తారు."},
    {"line_id": "E01-L006", "telugu": "ఆమె పాత్రకు నువ్వు సంతకం చేయవని మాట ఇవ్వు."},
    {"line_id": "E01-L007", "telugu": "ఏ పాత్ర?"},
    {"line_id": "E01-L014", "telugu": "అప్పు నాదే, పాత్ర నాదే, ఈ శీతాకాలం నాదే."},
    {"line_id": "E01-L015", "telugu": "మళ్ళీ చెప్పండి."},
    {"line_id": "E01-L017", "telugu": "ఆ మాట ఊచకు చెప్పండి, మిస్ట్రీస్."},
    {"line_id": "E01-L021", "telugu": "మీ అధికారం వల్లా? అవును."},
    {"line_id": "E01-L023", "telugu": "కాదు."},
    {"line_id": "E01-L024", "telugu": "ఆమె ఎల్లప్పుడూ కాదంటుంది ..."},
    {"line_id": "E01-L025", "telugu": "... ధర సరిగ్గా ఉంటే తప్ప."},
    {"line_id": "E01-L026", "telugu": "ఏడ్డా, నా బిడ్డా, ఎప్పుడూ ..."},
    {"line_id": "E01-L027", "telugu": "... ఈ రాత్రికి ఏదీ సంతకం చేయొద్దు."},
    {"line_id": "E01-L029", "telugu": "అత్తయ్య. క్రిస్మస్‌కు నువ్వు నన్ను అలా పిలిచావు."},
    {"line_id": "E01-L030", "telugu": "ఏవిధంగా పిలవాలంటే పిలవండి."},
    {"line_id": "E02-L004", "telugu": "టికెట్ పాయరంతో కాలిపోయింది."},
    {"line_id": "E02-L006", "telugu": "అంటే ఆయన తలలో మీరే నింపుతున్నారా?"},
    {"line_id": "E02-L007", "telugu": "అది ముందే నిండా."},
    {"line_id": "E02-L009", "telugu": "మిస్ట్రీస్ కేన్‌కు ఇది తెలుస్తుంది."},
    {"line_id": "E02-L010", "telugu": "తినమ్మా, అమ్మాయీ. నిలబడి ఉండాలని ఆయన కోరుతాడు."},
    {"line_id": "E02-L011", "telugu": "ఆయనకు కావల్సింది దీపమే."},
    {"line_id": "E02-L012", "telugu": "వసంతానికి ముందే నాన్నను ఆ రాతిమీద దించాలని ఆయన కోరుకుంటున్నాడు."},
    {"line_id": "E02-L013", "telugu": "అదే ఒకటే."},
    {"line_id": "E02-L015", "telugu": "హాలరన్ మేడమ్. కాపలాదారి శీతాకాలానికి కంపెనీ సహాయం చేయాలంటోంది."},
    {"line_id": "E02-L016", "telugu": "కేన్ చేసే దయాధనమా?"},
    {"line_id": "E02-L020", "telugu": "నాన్న సంతకం చేయరు. అదే సమాధానం."},
    {"line_id": "E02-L025", "telugu": "... మీకు ఎలా తెలుసు ..."},
    {"line_id": "E02-L026", "telugu": "ఆయన 61లో నాకు గేట్ చదవడం నేర్పించారు."},
    {"line_id": "E02-L028", "telugu": "ఊ, నాన్నా. నేను ఇక్కడే ఉన్నాను."},
    {"line_id": "E02-L029", "telugu": "సంతకం విలువ ఆమెకు తెలియదు."},
    {"line_id": "E02-L030", "telugu": "పాత్రలోని ఒక అంశంలా నన్ను 'ఆమె' అని పిలిచాడు."},
    {"line_id": "E02-L031", "telugu": "గేట్ వేసుకో, ఏడ్డా. ఆయన ఉద్దేశం నీవే."},
    {"line_id": "E03-L002", "telugu": "నాకు ఒక గంట ఉంది, మిస్ట్రీస్ కేన్."},
    {"line_id": "E03-L003", "telugu": "నీకు ఊచ ఉంది. అది కూడా తక్కువే."},
    {"line_id": "E03-L006", "telugu": "తీసుకెళ్ళు. నేను చూస్తూ ఉంటాను."},
    {"line_id": "E03-L008", "telugu": "ఆయన కొన్నాడు."},
    {"line_id": "E03-L010", "telugu": "చనిపోయిన వాడి పాత్రతో మీకు ఏమి కావాలి, సైలాస్?"},
    {"line_id": "E03-L011", "telugu": "నా పడకలో నీ పేరు, ఆ దీపంపై నా ముద్ర."},
    {"line_id": "E03-L012", "telugu": "నీకు ముద్ర విలువ లేదు. ఈమెను తీసుకెళ్ళు."},
    {"line_id": "E03-L014", "telugu": "ఎవరో చూశారు. మెట్ల నుండి."},
    {"line_id": "E03-L017", "telugu": "మీ దీపం నా పని."},
    {"line_id": "E03-L018", "telugu": "అయితే చెప్పండి, 61 విచారణ లేఖ కాపలాదారి కూతురికి ఎంత ఖర్చు?"},
    {"line_id": "E03-L021", "telugu": "ఈ రాత్రి కాదు."},
    {"line_id": "E03-L023", "telugu": "ధర కట్టిస్తున్నారే తప్ప, ఆమెను కోరడం లేదని ఆమెకు తెలియదు."},
    {"line_id": "E03-L024", "telugu": "అత్తయ్య అయితే అది సుతారంగా అనేవారు."},
    {"line_id": "E03-L025", "telugu": "నువ్వు ఆ ఇంటికి వెళ్ళావు. నా బిడ్డా, ఎందుకు వెళ్ళావు?"},
    {"line_id": "E03-L029", "telugu": "వాళ్ళని తీసుకెళ్ళనివ్వను."},
    {"line_id": "E03-L030", "telugu": "అది మాటగా చెప్పు, ఒక ..."},
    {"line_id": "E03-L031", "telugu": "... సవాలుగా. నాన్నా, వింటున్నాను."},
    {"line_id": "E04-L001", "telugu": "తిప్పుతూ ఉంచు. తిప్పుతూ ఉంచు."},
    {"line_id": "E04-L002", "telugu": "ఒకటి, రెండు, మూడు, నాలుగు ..."},
    {"line_id": "E04-L004", "telugu": "మెట్ల దీపం వెలిగించు! ఎవరైనా మెట్ల వెలిగించండి!"},
    {"line_id": "E04-L006", "telugu": "అప్పుడు అతను తడుస్తాడు, బ్రతకాడు — ఆ క్రమంలో."},
    {"line_id": "E04-L007", "telugu": "అతని వైపు తిరుగు. అతని వైపు తిరుగు, అతను నాన్న నీరు."},
    {"line_id": "E04-L009", "telugu": "ఎవరిదీ కాదు. గట్టు పగిలిపోలేదు."},
    {"line_id": "E04-L011", "telugu": "గట్టు నిలిచింది — ట్రాలర్ కాదు."},
    {"line_id": "E04-L013", "telugu": "ఇద్దరు బ్రతికారు, ముగ్గురు పోయారు, ఆ అబ్బాయి ఇంకా నా పడవలోనే."},
    {"line_id": "E04-L014", "telugu": "నా మట్టపై ముగ్గురు. నా ముందు చెప్పు."},
    {"line_id": "E04-L015", "telugu": "నీకు కావల్సినట్లు చెప్తాను."},
    {"line_id": "E04-L017", "telugu": "తర్వాత నిద్రపోలేది అతనే."},
    {"line_id": "E04-L018", "telugu": "జాస్ — కోట్. ఎవరిది?"},
    {"line_id": "E04-L021", "telugu": "అది ఒక్కటే కాదు."},
    {"line_id": "E04-L023", "telugu": "నాన్న తొమ్మిదో ఏట నన్ను ఇక్కడ నిలబెట్టి, లెక్క ఆపొద్దన్నారు."},
    {"line_id": "E04-L024", "telugu": "... తొమ్మిది, పది, పదకొండు, పన్నెండు ..."},
    {"line_id": "E04-L025", "telugu": "చాలు. దిగు."},
    {"line_id": "E04-L027", "telugu": "నాన్న దీపాన్ని ముట్టుకుంటే, మీరు దాని పక్కన కాదు — దానిలోపల నిలబడతారు."},
    {"line_id": "E05-L003", "telugu": "మునిగిపోకముందే దాన్ని ఖరారు చేశారు."},
    {"line_id": "E05-L007", "telugu": "ఫాదర్ ఆన్సెల్మ్. ఇది కూడా మీ పుస్తకమేనా?"},
    {"line_id": "E05-L009", "telugu": "కేన్ ఇస్తారా?"},
    {"line_id": "E05-L010", "telugu": "కేన్ ఇస్తారు, మీ నాన్నకు ఊపిరి ఇస్తాను, మీరే మౌనంగా ఉండండి."},
    {"line_id": "E05-L011", "telugu": "హాలరన్. రాజు సామాను అమ్మకం కోసం మీరు నాతో రావాలి."},
    {"line_id": "E05-L012", "telugu": "నేను వాటిని తిరిగి కొన్నాను. కొన్నది గుర్తున్న వాడు ఉన్నాడు."},
    {"line_id": "E05-L014", "telugu": "మెట్ల నుండి దిగు, సైలాస్ వేన్."},
    {"line_id": "E05-L015", "telugu": "నిశ్చయం ఇంకా ఉందా? రెండేళ్ళైనా ..."},
    {"line_id": "E05-L016", "telugu": "రెండేళ్ళయినా కాదు."},
    {"line_id": "E05-L017", "telugu": "61లో ఆ ధర బిగ్గన చెప్పు, పేరు ఎవరిదో చూడు."},
    {"line_id": "E05-L019", "telugu": "మీ బందరంలోనే, మిస్ట్రీస్ కేన్."},
    {"line_id": "E05-L022", "telugu": "నాన్న, ఆగి ఉండు. ఫాదర్ ఆన్సెల్మ్, ఆయన్ని పట్టుకోండి."},
    {"line_id": "E05-L026", "telugu": "అయితే దీపం అమ్మకానికే. నా కోట్లో డబ్బు ఉంది."},
    {"line_id": "E05-L027", "telugu": "కేన్ సొమ్ము తెచ్చిన పడవవాడా?"},
    {"line_id": "E05-L029", "telugu": "తొమ్మిది నెలలు నా ఆకలి చూశావ్?"},
    {"line_id": "E05-L031", "telugu": "అయితే ఎందుకు చెప్పలేదు?"},
    {"line_id": "E05-L032", "telugu": "నేను కొనేవాడినైతే, బాధ్యత కోసమైనా నన్ను భర్తగా చేసేదివి."},
    {"line_id": "E06-L002", "telugu": "అయితే నీటిముందు చదువుతాను. నీరు ఎక్కువ కాలం నిజం చెప్పింది."},
    {"line_id": "E06-L004", "telugu": "నా పాత్రనే నువ్వు కొన్నావు. నా డబ్బుతోనే."},
    {"line_id": "E06-L006", "telugu": "వాడిని అరెస్టు చేయండి! అక్రమ రవాణావాడు!"},
    {"line_id": "E06-L008", "telugu": "అయితే నాన్నపై ఆరోపణతో అరెస్టు చేయండి."},
    {"line_id": "E06-L010", "telugu": "మిగిలిన ఒకే ఒక్క బంధువును శత్రువుగా చేసుకున్నావు."},
    {"line_id": "E06-L011", "telugu": "అత్తయ్య. మీరు ఎప్పుడూ బంధువే. కానీ కరుణ లేని బంధువు."},
    {"line_id": "E06-L012", "telugu": "నీ దీపాన్ని కాపాడుకో, బిడ్డా."},
    {"line_id": "E06-L016", "telugu": "నేను పేరు రాస్తే, అప్పుడు నువ్వు ఎవరు?"},
    {"line_id": "E06-L017", "telugu": "నీ వెలుగు ఆపకుండా చూసే పడవవాడిని."},
    {"line_id": "E06-L018", "telugu": "ఇది చిన్న విషయం కాదు."},
    {"line_id": "E06-L019", "telugu": "ఏడ్డా. బిడ్డా. నా మెట్లపై మళ్ళీ నిలబడ్డాను, నన్ను చూడు."},
    {"line_id": "E06-L020", "telugu": "చూస్తున్నాను నాన్నా. చూస్తున్నాను."},
    {"line_id": "E06-L021", "telugu": "... పదమూడు."},
    {"line_id": "E06-L023", "telugu": "మెట్ల వెలిగించు, ఏడ్డా. మూడు పడవలు ఇంటికి వస్తున్నాయి."},
    {"line_id": "E06-L024", "telugu": "దీపం వెలుగుతూనే ఉంటుంది."}
  ]
}
